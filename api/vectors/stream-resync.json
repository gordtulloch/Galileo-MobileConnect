{
  "name": "stream-resync",
  "description": "A stream drops while an operation is in flight. On reconnect the Master answers `resync` (the replay ring no longer holds the gap), so the client discards its state, shows the in-flight operation as OutcomeUnknown, does NOT re-send it, and shows values as stale until a fresh snapshot arrives.",
  "status": "planned",
  "requirements": ["MAPP-CON-070", "MAPP-CTL-070", "MAPP-OVR-040"],
  "steps": [
    { "do": "stream", "frame": { "type": "hello", "epoch": "e1", "seq": 0 } },
    { "do": "stream", "frame": { "seq": 1, "data": { "type": "snapshot", "as_of": "2026-11-06T02:00:00Z", "piers": { "p1": { "mount": { "tracking": true } } } } } },
    { "do": "expect", "outcome": "Live", "state": { "p1.mount.tracking": { "value": true, "stale": false } } },
    { "do": "send", "method": "POST", "path": "/mobileconnect/v1/pier/p1/ops/mount.slew", "headers": { "Idempotency-Key": "k1" }, "body": { "args": { "ra_deg": 83.8, "dec_deg": -5.4 } } },
    { "do": "expect", "outcome": "Pending", "state": { "operation.k1": "Pending" } },
    { "do": "drop", "note": "the WebSocket closes without a closing frame" },
    { "do": "expect", "outcome": "OutcomeUnknown", "state": { "operation.k1": "OutcomeUnknown", "p1.mount.tracking": { "stale": true }, "connection": "Reconnecting" } },
    { "do": "clock", "advance_s": 3 },
    { "do": "stream", "frame": { "type": "resync", "epoch": "e2", "seq": 40 } },
    { "do": "expect", "outcome": "Resyncing", "state": { "operation.k1": "OutcomeUnknown", "requests_sent_with_key": { "k1": 1 } } },
    { "do": "stream", "frame": { "seq": 41, "data": { "type": "snapshot", "as_of": "2026-11-06T02:00:09Z", "piers": { "p1": { "mount": { "tracking": true, "slewing": true } } } } } },
    { "do": "expect", "outcome": "Live", "state": { "p1.mount.slewing": { "value": true, "stale": false }, "operation.k1": "OutcomeUnknown" } }
  ]
}
