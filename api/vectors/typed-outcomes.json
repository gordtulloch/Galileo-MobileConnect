{
  "name": "typed-outcomes",
  "description": "Every typed refusal shows the Master's reason and is not retried; an unexpected status is never shown as success.",
  "status": "planned",
  "requirements": ["MAPP-CTL-030", "MAPP-CTL-050"],
  "steps": [
    { "do": "act", "action": "invoke", "pier": "p1", "operation": "mount.sync", "args": { "ra_deg": 10, "dec_deg": 10 } },
    { "do": "send", "method": "POST", "path": "/mobileconnect/v1/ops?pier=p1&name=mount.sync", "headers": { "Idempotency-Key": "k1" } },
    { "do": "receive", "status": 409, "body": { "error": "refused", "reason": "Desktop holds the lease.", "detail": { "kind": "lease_held", "holder": "Desktop", "can_take": true } } },
    { "do": "expect", "state": { "operation.k1": "Refused: Desktop holds the lease.", "requests_sent": 1 } },
    { "do": "act", "action": "invoke", "pier": "p1", "operation": "mount.track", "args": { "enabled": true } },
    { "do": "send", "method": "POST", "path": "/mobileconnect/v1/ops?pier=p1&name=mount.track", "headers": { "Idempotency-Key": "k2" } },
    { "do": "receive", "status": 503, "body": { "error": "busy", "reason": "Try again shortly." } },
    { "do": "expect", "state": { "operation.k2": "Busy: Try again shortly." } },
    { "do": "act", "action": "invoke", "pier": "p1", "operation": "mount.unpark", "note": "on the always-confirm list" },
    { "do": "expect", "outcome": "ConfirmationRequired" },
    { "do": "act", "action": "confirm" },
    { "do": "send", "method": "POST", "path": "/mobileconnect/v1/ops?pier=p1&name=mount.unpark", "headers": { "Idempotency-Key": "k3" } },
    { "do": "receive", "status": 503, "body": { "error": "unreachable", "reason": "The spoke is offline." } },
    { "do": "expect", "state": { "operation.k3": "Unreachable: The spoke is offline." } },
    { "do": "act", "action": "invoke", "pier": "p1", "operation": "mount.abort_slew" },
    { "do": "send", "method": "POST", "path": "/mobileconnect/v1/ops?pier=p1&name=mount.abort_slew", "headers": { "Idempotency-Key": "k4" } },
    { "do": "receive", "status": 400, "body": { "error": "unavailable", "reason": "This Pier has no mount." } },
    { "do": "expect", "state": { "operation.k4": "Unavailable: This Pier has no mount.", "requests_sent": 4 } }
  ]
}
