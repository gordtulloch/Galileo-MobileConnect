    { "at_s": 18, "pier": "p1", "set": { "session.progress": 0.5, "session.message": "Exposure 8 of 30", "imaging.frame": 8, "session.frames_done": 8 } },
    { "at_s": 22, "pier": "p1", "set": { "session.progress": 0.75, "session.message": "Exposure 22 of 30", "imaging.frame": 22, "session.frames_done": 22 } },
    { "at_s": 26, "pier": "p1", "set": { "session.progress": 0.95, "session.message": "Exposure 30 of 30", "imaging.frame": 30, "session.frames_done": 30 } },
    { "at_s": 30, "pier": "p1", "set": { "session.state": "Complete", "activity.session": "Complete", "session.progress": 1.0, "session.block_index": 12, "session.block": "Done", "session.message": "Session complete: 30 frames", "imaging.state": "Idle", "camera.state": "Idle", "activity.capture": "Idle" } },
    { "at_s": 30, "alert": { "severity": "info", "pier": "p1", "message": "Session M42 — LRGB complete: 30 frames.", "important": false } }
  ] }
