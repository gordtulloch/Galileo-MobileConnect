{ "extends": "normal-night", "name": "session-run", "description": "A session from start to finish: it starts, steps through its blocks (slew, centre, focus, series), reports progress, and completes.",
  "loop_s": 0, "timeline": [
    { "at_s": 2, "pier": "p1", "set": { "session.state": "Starting", "activity.session": "Starting", "session.progress": 0.0, "session.block_index": 1, "session.frames_done": 0, "imaging.frame": 0, "imaging.state": "Idle", "activity.capture": "Idle", "session.block": "Slew to M42", "session.message": "Slewing", "mount.slewing": true, "activity.mount": "Slewing" } },
