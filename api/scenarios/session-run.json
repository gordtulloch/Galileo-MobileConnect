    { "at_s": 10, "pier": "p1", "set": { "session.progress": 0.2, "session.block_index": 3, "session.block": "Autofocus", "session.message": "Focusing", "activity.solve": "Idle", "solve.running": false, "focus.state": "Autofocus", "activity.focus": "Autofocus" } },
