{
  "_comment": "S-DSN (docs/SDD.md 3.10). The single source of colours and sizes for every platform. scripts/gen_tokens.py checks contrast and that Night is red only, then writes each platform's resource.",
  "themes": {
    "light": { "background": "#F4F3F1", "surface": "#FFFFFF", "raised": "#E9E7E3", "border": "#C9C5BE", "text": "#17181A", "textSecondary": "#55585D", "accent": "#0B5CAD", "onAccent": "#FFFFFF", "danger": "#B3261E", "onDanger": "#FFFFFF", "warning": "#8A5A00", "good": "#1B6E3C", "imageTint": "#FFFFFF" },
    "dark": { "background": "#101114", "surface": "#1B1D21", "raised": "#272A30", "border": "#3C4047", "text": "#F1F1EF", "textSecondary": "#B4B7BC", "accent": "#7CB7F2", "onAccent": "#0B1B2B", "danger": "#FF8A80", "onDanger": "#2B0805", "warning": "#E8B85A", "good": "#7FD19B", "imageTint": "#FFFFFF" },
    "night": { "background": "#000000", "surface": "#120000", "raised": "#240000", "border": "#660000", "text": "#FF0000", "textSecondary": "#F00000", "accent": "#FF0000", "onAccent": "#000000", "danger": "#FF0000", "onDanger": "#000000", "warning": "#FF0000", "good": "#FF0000", "imageTint": "#FF0000" }
  },
  "contrast": [
    ["text", "background"], ["text", "surface"], ["textSecondary", "background"], ["textSecondary", "surface"],
    ["onAccent", "accent"], ["onDanger", "danger"], ["warning", "surface"], ["good", "surface"], ["danger", "surface"], ["accent", "surface"]
  ],
  "minimumContrast": 4.5,
  "layout": { "minimumTarget": 56, "spacing": 12, "cornerRadius": 12 }
}
