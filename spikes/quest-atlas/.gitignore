.gradle/
build/
app/build/
app/.cxx/
local.properties
*.apk
# Derived from VizieR I/239 by tools/make_stars.py
app/src/main/assets/stars.bin
# Derived from KStars clines.dat/cnames.dat (GPL-2) by tools/make_constellations.py
app/src/main/assets/constlines.bin
app/src/main/assets/constnames.txt
# DSS2 map (STScI, research/education use), Arial atlas (Monotype font, do not redistribute),
# and the home observing site - all regenerated by tools/make_*.py
app/src/main/assets/dssbg.bin
app/src/main/assets/fontarial.bin
app/src/main/assets/site.txt
app/src/main/assets/deepsky.bin
app/src/main/assets/asteroids.bin
app/src/main/assets/satellites.bin
# SkyView DSS2 cutouts (STScI, research/education use) baked by tools/make_dss.py, and its download cache
app/src/main/assets/dss.bin
tools/.dsscache/
app/src/main/assets/deepinfo.txt
tools/.infocache.json
# Music is the user's own; only the folder is tracked
app/src/main/assets/music/*
!app/src/main/assets/music/.gitkeep
app/src/main/assets/speech/
tools/.speechcache/
app/src/main/assets/dss2/
app/src/main/assets/dss2.idx
